{
	"$schema": "https://opencode.ai/config.json",
	"update": "disable",
	"model": "openai/gpt-6.1-sol",
	"lsp": false,
	"formatter": false,
	"snapshots": false,
	"permissions": [
		{ "action": "external_directory", "resource": "*", "effect": "allow" },
		{ "action": "execute", "resource": "*", "effect": "allow" },
		{ "action": "shell", "resource": "opencode *", "effect": "deny" },
		{ "action": "shell", "resource": "*/opencode *", "effect": "deny" },
		{ "action": "shell", "resource": "opencode2 *", "effect": "deny" },
		{ "action": "shell", "resource": "*/opencode2 *", "effect": "deny" }
	],
	"mcp": {
		"servers": {
			"agent-browser": {
				"type": "local",
				"command": ["agent-browser", "mcp"],
				"disabled": false,
				"codemode": true
			},
			"chrome-devtools": {
				"type": "local",
				"command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect", "--userDataDir", "{env:HOME}/.agent-browser/profile", "--no-usage-statistics", "--no-performance-crux"],
				"disabled": false,
				"codemode": true
			},
			"ios-simulator": {
				"type": "local",
				"command": ["npx", "-y", "ios-simulator-mcp"],
				"disabled": false,
				"codemode": true
			},
			"git-bug": {
				"type": "local",
				"command": ["bun", "run", "{env:HOME}/.config/dotfiles/git-bug-mcp/index.ts"],
				"disabled": false,
				"codemode": true
			}
		}
	}
}
