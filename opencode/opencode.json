{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"permission": {
		"external_directory": "allow",
		"bash": {
			"opencode *": "deny",
			"*/opencode *": "deny"
		}
	},
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (local)",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"gemma4:e4b-mlx": {
					"name": "Gemma 4 e4b MLX (local)",
					"tool_call": true,
					"limit": {
						"context": 128000,
						"output": 8192
					}
				}
			}
		}
	},
	"mcp": {
		"linear": {
			"type": "remote",
			"url": "https://mcp.linear.app/mcp",
			"enabled": true
		},
		"posthog": {
			"type": "remote",
			"url": "https://mcp-eu.posthog.com/mcp",
			"enabled": true
		},
		"supabase": {
			"type": "remote",
			"url": "https://mcp.supabase.com/mcp?read_only=true",
			"enabled": true
		},
		"chrome-devtools": {
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp@latest"],
			"enabled": true
		}
	},
	"agent": {
		"ollama": {
			"description": "Local Ollama profile without MCP or delegated agents, quick checks and summaries",
			"mode": "primary",
			"model": "ollama/gemma4:e4b-mlx",
			"permission": {
				"linear_*": "deny",
				"posthog_*": "deny",
				"supabase_*": "deny",
				"chrome-devtools_*": "deny",
				"task": "deny"
			}
		}
	}
}
