{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"model": "opencode-go/deepseek-v4.1-flash",
	"plugin": ["opencode-pty"],
	"instructions": ["./pty.md"],
	"experimental": {
		"disable_paste_summary": true
	},
	"permission": {
		"external_directory": "allow",
		"bash": {
			"opencode *": "deny",
			"*/opencode *": "deny"
		}
	},
	"mcp": {
		"agent-browser": {
			"type": "local",
			"command": ["agent-browser", "mcp"],
			"enabled": true
		},
		"chrome-devtools": {
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect", "--userDataDir", "{env:HOME}/.agent-browser/profile", "--no-usage-statistics", "--no-performance-crux"],
			"enabled": true
		},
		"ios-simulator": {
			"type": "local",
			"command": ["npx", "-y", "ios-simulator-mcp"],
			"enabled": true
		},
		"git-bug": {
			"type": "local",
			"command": ["bun", "run", "{env:HOME}/.config/dotfiles/git-bug-mcp/index.ts"],
			"enabled": true
		}
	}
}
