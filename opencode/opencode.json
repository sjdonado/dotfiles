{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"model": "opencode-go/deepseek-v4.1-flash",
	"plugin": ["opencode-pty"],
	"instructions": ["./pty.md"],
	"experimental": {
		"disable_paste_summary": true
	},
	"permission": {
		"external_directory": "allow",
		"bash": {
			"opencode *": "deny",
			"*/opencode *": "deny"
		}
	},
	"mcp": {
		"browser": {
			"type": "local",
			"command": ["bun", "run", "{env:HOME}/Developer/browser-mcp/index.ts"],
			"enabled": true
		},
		"ios-simulator": {
			"type": "local",
			"command": ["npx", "-y", "ios-simulator-mcp"],
			"enabled": true
		},
		"git-bug": {
			"type": "local",
			"command": ["bun", "run", "{env:HOME}/.config/dotfiles/git-bug-mcp/index.ts"],
			"enabled": true
		}
	}
}
