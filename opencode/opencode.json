{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"model": "opencode/gemini-3.8-flash",
	"plugin": ["opencode-pty"],
	"instructions": ["./pty.md"],
	"experimental": {
		"disable_paste_summary": true
	},
	"permission": {
		"external_directory": "allow",
		"bash": {
			"opencode *": "deny",
			"*/opencode *": "deny"
		}
	},
	"mcp": {
		"chrome-devtools": {
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp@latest"],
			"enabled": true
		},
		"ios-simulator": {
			"type": "local",
			"command": ["npx", "-y", "ios-simulator-mcp"],
			"enabled": true
		}
	}
}
