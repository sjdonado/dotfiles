{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(git stash:*)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --keep:*)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(git checkout -f:*)",
      "Bash(git restore:*)",
      "Bash(git worktree:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(wt merge:*)",
      "Bash(gh pr merge:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.config/dotfiles/claude/statusline.sh\"",
    "padding": 0,
    "refreshInterval": 60
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
