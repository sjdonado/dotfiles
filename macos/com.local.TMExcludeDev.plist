<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.TMExcludeDev</string>
  <!-- Login Items names a background item after the executable it launches, so
       running this through `sh -c` listed it as a bare "sh" with no hint of what
       it does. The script has its own shebang and is executable, so naming it
       directly makes the row read tm-exclude-dev.sh. launchd does not expand
       $HOME, which is what the shell was for, so macos.sh substitutes the real
       path when it installs this file. -->
  <key>ProgramArguments</key>
  <array>
    <string>__TM_EXCLUDE_SCRIPT__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/tm-exclude-dev.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tm-exclude-dev.log</string>
</dict>
</plist>
