<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.KeyRemapping</string>
  <!-- The hidutil call lives in caps-to-control.sh: Login Items names a
       background item after the executable it launches, so passing the mapping
       as arguments here listed the row as a bare "hidutil". macos.sh substitutes
       the real path, since launchd does not expand $HOME. -->
  <key>ProgramArguments</key>
  <array>
    <string>__CAPS_TO_CONTROL_SCRIPT__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
