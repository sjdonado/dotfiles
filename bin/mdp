#!/bin/sh
# Read a markdown file in the terminal with its tables, images, and mermaid
# diagrams intact. Mermaid fences are rendered to PNG (mmdc) and everything else
# is pandoc GFM; the result opens in chawan, which draws images over the Kitty
# graphics protocol. The HTML path is stable per source, so a re-run overwrites
# it in place and chawan's own `U` reload re-reads the same URL.
#
# Run this as a direct child of the terminal that displays it. A nested terminal
# emulator (an editor's embedded terminal, for instance) consumes the graphics
# protocol, and the images silently render as a blank gap. This is a constraint
# of the protocol, not a defect here.
set -eu

usage() { echo "usage: mdp [--print] FILE.md" >&2; exit 2; }

print_only=0
case ${1:-} in
  --print) print_only=1; shift ;;
  -h|--help) echo "usage: mdp [--print] FILE.md"; exit 0 ;;
  -*) usage ;;
esac
src=${1:-}
[ -n "$src" ] || usage
[ -f "$src" ] || { echo "mdp: no such file: $src" >&2; exit 1; }
case $src in /*) ;; *) src=$PWD/$src ;; esac

for dep in pandoc cha; do
  command -v "$dep" >/dev/null 2>&1 || { echo "mdp: $dep not installed" >&2; exit 1; }
done

# Ghostty accepts far more image data over the wire than it will draw: it took
# 66 MB over the wire, yet silently failed to DISPLAY a 24 MB decoded diagram in
# a 56-row tab that drew fine in a 33-row split. So a diagram is capped by decoded size
# (width * height * 4), never by a fixed scale multiplier. The budget is per
# terminal and per window size, which is why it is tunable.
budget=${MDP_IMAGE_BUDGET:-12582912}
case $budget in
  ''|*[!0-9]*) budget=0 ;;
esac
[ "$budget" -ge 65536 ] || {
  echo "mdp: MDP_IMAGE_BUDGET must be a size in bytes, at least 65536" >&2; exit 2
}

cache=${XDG_CACHE_HOME:-$HOME/.cache}/mdp
key=$(printf '%s' "$src" | cksum | tr -s ' ' '-')
dir=$cache/$key
mkdir -p "$dir"
rm -f "$dir"/m[0-9]*.mmd "$dir"/m[0-9]*.png "$dir"/m[0-9]*.scaled.png
html=$dir/preview.html

# Terminal width in pixels, which is what a diagram is sized against. CSI 14 t
# answers `CSI 4 ; height ; width t`; a terminal that does not answer leaves the
# columns-times-a-cell estimate. The query goes to /dev/tty rather than stdout,
# which is a pipe whenever this function is called in a substitution, and the
# trap puts the terminal back if anything interrupts the raw-mode read.
term_px_width() {
  cols=$(tput cols 2>/dev/null || echo 80)
  px=
  if { : >/dev/tty; } 2>/dev/null && stty_save=$(stty -g </dev/tty 2>/dev/null); then
    trap 'stty "$stty_save" </dev/tty 2>/dev/null || true' EXIT INT TERM HUP
    if stty raw -echo min 0 time 2 </dev/tty 2>/dev/null; then
      printf '\033[14t' >/dev/tty
      px=$(dd bs=32 count=1 </dev/tty 2>/dev/null | tr -d '\000' \
        | sed -n 's/.*\[4;[0-9]*;\([0-9][0-9]*\)t.*/\1/p')
    fi
    stty "$stty_save" </dev/tty 2>/dev/null || true
    trap - EXIT INT TERM HUP
  fi
  case $px in
    ''|*[!0-9]*) echo $((cols * 8)) ;;
    *) [ "$px" -gt 0 ] && echo "$px" || echo $((cols * 8)) ;;
  esac
}

# A PNG's pixel width and decoded size in bytes, both from its IHDR header.
# Fails rather than doing arithmetic on a truncated or non-PNG file, so a broken
# render degrades to the fence's source instead of aborting the run.
png_size() {
  hex=$(od -An -tx1 -j16 -N8 "$1" 2>/dev/null | tr -d ' \n')
  [ ${#hex} -eq 16 ] || return 1
  case $hex in *[!0-9a-f]*) return 1 ;; esac
  w=$((0x${hex%????????}))
  h=$((0x${hex#????????}))
  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
  echo "$w $((w * h * 4))"
}

# Pull each fenced ```mermaid block into its own file. Nothing is emitted here:
# whether a fence becomes an image or stays as source depends on whether mmdc
# produced a PNG for it, which is only known after the render loop below.
awk -v dir="$dir" '
  /^[ 	]*```[ 	]*mermaid/ { inm = 1; n++; f = dir "/m" n ".mmd"; printf "" > f; next }
  inm && /^[ 	]*```[ 	]*$/ { inm = 0; close(f); next }
  inm                                    { print >> f }
' "$src"

# mmdc's --width only sizes the page it lays the diagram out on; the PNG comes
# out at the diagram's intrinsic size, so --scale is the only size knob. Render
# once at scale 1 to learn that size, then scale to fill the terminal's width,
# but never past the point where the decoded PNG exceeds the budget: decoded
# size grows with the square of the scale, so the ceiling is
# sqrt(budget / decoded-at-1), and that ceiling is allowed below 1, because a
# diagram that is already over budget has to shrink.
rendered=,
if command -v mmdc >/dev/null 2>&1; then
  width=$(term_px_width)
  n=1
  while [ -f "$dir/m$n.mmd" ]; do
    mmd=$dir/m$n.mmd
    png=$dir/m$n.png
    scaled=$dir/m$n.scaled.png
    if mmdc -i "$mmd" -o "$png" -b transparent -t dark >/dev/null 2>&1 \
      && [ -s "$png" ] && size=$(png_size "$png"); then
      scale=$(LC_ALL=C awk -v px="$width" -v b="$budget" \
        -v w="${size% *}" -v d="${size#* }" 'BEGIN {
          if (w <= 0 || d <= 0 || px <= 0) { printf "1.00"; exit }
          # 0.95 leaves room for the renderer rounding the scaled pixel size
          # up, which would otherwise land a hair over the budget.
          fit = px / w; cap = sqrt(0.95 * b / d)
          s = (fit < cap) ? fit : cap
          if (s < 0.01) s = 0.01
          printf "%.3f", s
        }')
      # Scaled into a sidecar and promoted only on success, so a failed second
      # render leaves the scale-1 PNG rather than a truncated one.
      if [ "$scale" != "1.000" ] \
        && mmdc -i "$mmd" -o "$scaled" -b transparent -t dark -s "$scale" >/dev/null 2>&1 \
        && [ -s "$scaled" ]; then
        mv "$scaled" "$png"
      fi
      rm -f "$scaled"
      rendered="$rendered$n,"
    fi
    n=$((n + 1))
  done
fi

# Swap each fence for its image, or leave the fence's source in place when no
# PNG was produced, so a missing mmdc degrades to a readable document rather
# than a broken image reference. The path is bracketed because a cache path
# containing a space is otherwise not a link destination at all.
awk -v dir="$dir" -v rendered="$rendered" '
  /^[ 	]*```[ 	]*mermaid/ {
    n++
    if (index(rendered, "," n ",") > 0) { inm = 1; print "![](<" dir "/m" n ".png>)"; next }
  }
  inm && /^[ 	]*```[ 	]*$/ { inm = 0; next }
  inm                                    { next }
                                         { print }
' "$src" > "$dir/pre.md"

# Boxed cells so a wide table wraps inside its own column instead of running off
# the page, and images scaled down to the page width so a diagram fits.
style=$dir/style.html
cat > "$style" <<'CSS'
<style>
  img { max-width: 100%; height: auto; }
  table { border-collapse: collapse; }
  th, td { border: 1px solid; padding: 0.15em 0.6em; vertical-align: top; }
  code { padding: 0 0.2em; }
  pre { padding: 0.4em 0.6em; }
</style>
CSS

pandoc "$dir/pre.md" -f gfm -t html -s \
  --metadata title="$(basename "$src")" \
  --include-in-header="$style" \
  -o "$html.new"
mv "$html.new" "$html"

if [ "$print_only" = 1 ] || [ ! -t 1 ]; then
  echo "$html"
else
  exec cha -o buffer.images=true "$html"
fi
