#!/bin/sh
# delta wrapper: GitHub syntax palette (matches agent TUI code render) + --dark/
# --light. Feature styles live in ~/.gitconfig ([delta "github-*"]). Keep
# hyperlinks for click-to-jump in lazygit.
#
# Resolve appearance on every invocation, not from an environment variable.
# BAT_THEME is exported once at shell startup, so it goes stale the moment macOS
# appearance changes, and it is absent entirely for anything not launched from an
# interactive shell (nvim's terminal, lazygit, an agent), which would silently
# pick the wrong palette.
if [ "$(uname)" = Darwin ]; then
  # defaults(1) prints nothing and exits nonzero in light mode.
  if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = Dark ]; then
    light=0
  else
    light=1
  fi
else
  # Linux has no system light/dark, and is reached through an already-dark
  # terminal, so default to dark. An explicit BAT_THEME still wins.
  case "${BAT_THEME:-}" in
    *Light*|*light*) light=1 ;;
    *) light=0 ;;
  esac
fi

if [ "$light" = 1 ]; then
  mode=--light
  feature=github-light
else
  mode=--dark
  feature=github-dark
fi

exec delta \
  "$mode" \
  --features="$feature" \
  --paging=never \
  --side-by-side \
  --line-numbers \
  --hyperlinks \
  --hyperlinks-file-link-format="lazygit-edit://{path}:{line}" \
  "$@"
