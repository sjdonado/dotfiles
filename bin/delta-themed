#!/bin/sh
# delta wrapper: GitHub syntax palette (matches agent TUI code render) + --dark/
# --light. Feature styles live in ~/.gitconfig ([delta "github-*"]). Keep
# hyperlinks for click-to-jump in lazygit.
#
# Herdr owns the pane palette, including a remote Moshi session. Fall back to
# the local system only when no Herdr pane is present or its query fails.
theme=
if [ "${HERDR_ENV:-}" = 1 ]; then
  theme="$("$HOME/.config/dotfiles/bin/herdr-theme-mode" 2>/dev/null || :)"
fi
if [ "$theme" = light ]; then
  light=1
elif [ "$theme" = dark ]; then
  light=0
elif [ "$(uname)" = Darwin ]; then
  # defaults(1) prints nothing and exits nonzero in light mode.
  if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = Dark ]; then
    light=0
  else
    light=1
  fi
else
  # Linux has no system light/dark, and is reached through an already-dark
  # terminal, so default to dark. An explicit BAT_THEME still wins.
  case "${BAT_THEME:-}" in
    *Light*|*light*) light=1 ;;
    *) light=0 ;;
  esac
fi

if [ "$light" = 1 ]; then
  mode=--light
  feature=github-light
else
  mode=--dark
  feature=github-dark
fi

exec delta \
  "$mode" \
  --features="$feature" \
  --paging=never \
  --side-by-side \
  --line-numbers \
  --hyperlinks \
  --hyperlinks-file-link-format="lazygit-edit://{path}:{line}" \
  "$@"
