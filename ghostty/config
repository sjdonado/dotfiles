# TEMPFIX: pinned to dark, no light variant. Light/dark syncing is broken for the
# agents -- an already-running Claude or OpenCode keeps whatever palette it started
# with, so a flip leaves them mismatched against the terminal. Staying on one side
# means nothing can drift. Neovim is unaffected; it tracks a flip on its own.
#
# To restore the pair, the light theme is "Apple System Colors Light":
#   theme = dark:Apple System Colors,light:Apple System Colors Light
theme = Apple System Colors

font-family = Menlo
font-family = Symbols Nerd Font Mono
font-thicken = true
font-size = 13

window-inherit-font-size = false
window-padding-y = 0

cursor-style = block
mouse-scroll-multiplier = 1

cursor-invert-fg-bg = false
selection-invert-fg-bg = false

shell-integration = fish
shell-integration-features = no-cursor

# Left Option sends Alt/Meta so alt+... bindings reach the shell and TUIs;
# right Option keeps macOS Unicode input (option+n for ñ, option+e for accents).
macos-option-as-alt = right

keybind = cmd+s=text:\x13
keybind = shift+enter=text:\x1b\r
