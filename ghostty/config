# Ghostty's bundled capture of Terminal.app's default Basic profile, rather
# than a hand-rolled palette: #ffffff/#000000 light, #1d1e1d/#ffffff dark, and
# the classic muted ANSI set (red #990000, blue #0000b2) that Terminal has
# shipped for years. "Apple System Colors" is the other Apple-derived pair here
# and uses the modern AppKit palette (#ff453a, #0a84ff) instead.
theme = dark:Terminal Basic Dark,light:Terminal Basic

font-family = Menlo
font-family = Symbols Nerd Font Mono
font-thicken = true
font-size = 13

window-inherit-font-size = false
window-padding-y = 0

cursor-style = block
mouse-scroll-multiplier = 1

cursor-invert-fg-bg = false
selection-invert-fg-bg = false

shell-integration = fish
shell-integration-features = no-cursor

# Left Option sends Alt/Meta so alt+... bindings reach the shell and TUIs;
# right Option keeps macOS Unicode input (option+n for ñ, option+e for accents).
macos-option-as-alt = right

keybind = cmd+s=text:\x13
keybind = shift+enter=text:\x1b\r
keybind = cmd+shift+y=text:\x01\x19
keybind = global:ctrl+]=toggle_quick_terminal
quick-terminal-position = right
quick-terminal-size = 40%,100%
# Known upstream bug: macOS window-state restoration can freeze the quick
# terminal's width to a cached frame, ignoring quick-terminal-size changes.
# https://github.com/ghostty-org/ghostty/discussions/8525
# window-save-state = never
