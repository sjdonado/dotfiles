# TEMPFIX: pinned to dark, no light variant. Light/dark syncing is broken for the
# agents -- an already-running Claude or OpenCode keeps whatever palette it started
# with, so a flip leaves them mismatched against the terminal. Staying on one side
# means nothing can drift. Neovim is unaffected; it tracks a flip on its own.
#
# To restore the pair, the light theme is "Apple System Colors Light":
#   theme = dark:Apple System Colors,light:sjdonado-light.conf
theme = dark:sjdonado-dark.conf,light:sjdonado-light.conf

font-family = Menlo
font-family = Symbols Nerd Font Mono
font-thicken = true
font-size = 13

window-inherit-font-size = false
window-padding-y = 0

cursor-style = block
mouse-scroll-multiplier = 1

cursor-invert-fg-bg = false
selection-invert-fg-bg = false

shell-integration = fish
shell-integration-features = no-cursor

# Left Option sends Alt/Meta so alt+... bindings reach the shell and TUIs;
# right Option keeps macOS Unicode input (option+n for ñ, option+e for accents).
macos-option-as-alt = right

keybind = cmd+s=text:\x13
keybind = shift+enter=text:\x1b\r

# cmd+1..9 switches herdr workspaces. Two problems to get past: Ghostty binds
# these to its own tabs (unused, herdr is the multiplexer and runs in one
# window), and macOS terminals have no legacy encoding for a modified digit, so
# even unbound the chord would transmit nothing. Both are solved by sending the
# bytes directly: CSI 49..57 ; 7 u is the Kitty-protocol form of ctrl+alt+1..9,
# which is what herdr/config.toml binds switch_workspace to. ctrl+alt is the
# family herdr documents as safe, since terminals and shells leave it alone.
keybind = super+digit_1=text:\x1b[49;7u
keybind = super+digit_2=text:\x1b[50;7u
keybind = super+digit_3=text:\x1b[51;7u
keybind = super+digit_4=text:\x1b[52;7u
keybind = super+digit_5=text:\x1b[53;7u
keybind = super+digit_6=text:\x1b[54;7u
keybind = super+digit_7=text:\x1b[55;7u
keybind = super+digit_8=text:\x1b[56;7u
keybind = super+digit_9=text:\x1b[57;7u
