{
  "http": { "enabled": true, "host": "127.0.0.1", "port": 4701 },
  "capacity": {
    "strategy": "fixed",
    "config": {
      "maxRunning": 3,
      "ios": { "maxDevices": 3, "maxRunning": 3 },
      "android": { "maxDevices": 1, "maxRunning": 1 }
    }
  },
  "drivers": { "ios": { "deviceSet": "simlock" } },
  "devices": { "autoEnroll": false },
  "downloads": { "policy": "never" },
  "lease": { "maxPerRequester": 3 },
  "warmPool": {
    "enabled": false,
    "maxConcurrentBoots": 1,
    "targets": [
      { "platform": "ios", "model": "iPhone 17", "osVersion": "27.2", "count": 1 },
      { "platform": "ios", "model": "iPad (A16)", "osVersion": "27.2", "count": 1 },
      { "platform": "ios", "model": "iPhone Duo", "osVersion": "27.2", "count": 1 }
    ]
  },
  "capabilities": {
    "agent-device": { "enabled": true },
    "stream": { "enabled": true },
    "input": { "enabled": true }
  }
}
