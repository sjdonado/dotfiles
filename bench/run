#!/bin/sh
# Run the fixed task battery in fresh headless sessions and save metrics.
#
#   bench/run <label>            # e.g. bench/run baseline
#
# Each task runs in its own session via `claude -p`, so nothing bleeds between
# tasks and nothing joins this repo's interactive history. Cost: five real
# sessions on the account. Quality is judged by a human against the `expect`
# comment at the top of each task file; metrics land in bench/runs/<label>/.
#
# Always the cheap tier: haiku here, luna when driving the battery through
# opencode. Absolute numbers are model-dependent, so a delta only means
# something between runs on the same model; see bench/README.md.
set -eu

label=${1:?usage: bench/run <label>}
model=${BENCH_MODEL:-haiku}
dir="$(cd "$(dirname "$0")" && pwd)"
out="$dir/runs/$label"
mkdir -p "$out"
printf '{"label":"%s","model":"%s","date":"%s","dotfiles":"%s"}\n' \
  "$label" "$model" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  "$(git -C "$dir/.." rev-parse --short HEAD 2>/dev/null || echo '?')" > "$out/meta.json"

for task in "$dir"/tasks/*.md; do
  name=$(basename "$task" .md)
  echo "==> $name"
  # Strip the expect comment so the criteria never steer the model. The one-line
  # form is handled first: a same-line open/close otherwise starts a sed range
  # whose end is only searched from the next line, deleting the whole file.
  prompt=$(sed '/^<!--.*-->$/d; /^<!--/,/-->$/d' "$task")
  result=$(claude -p "$prompt" --model "$model" --output-format json 2>"$out/$name.stderr" || true)
  printf '%s\n' "$result" > "$out/$name.result.json"
  # --output-format json yields an array of events; the init event carries the id.
  session=$(printf '%s' "$result" | python3 -c '
import json,sys
d=json.load(sys.stdin)
for e in (d if isinstance(d,list) else [d]):
    if e.get("session_id"): print(e["session_id"]); break' 2>/dev/null || true)
  if [ -n "$session" ]; then
    "$dir/measure" "$session" --save "$out/$name.metrics.json" >/dev/null
    echo "    session $session measured"
  else
    echo "    FAILED to get a session id (see $out/$name.stderr)"
  fi
done

echo
echo "Saved to $out. Compare with:"
echo "  diff <(jq .tokens bench/runs/<a>/<task>.metrics.json) <(jq .tokens bench/runs/<b>/<task>.metrics.json)"
