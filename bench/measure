#!/usr/bin/env python3
"""Run a disposable harness probe or measure explicit Codex exec JSONL transcripts.

Usage: bench/measure run [--model gpt-5.6-luna]
       bench/measure analyze SESSION.jsonl [SESSION.jsonl ...]
"""

import argparse
import collections
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
MODEL = "gpt-5.6-luna"
BRANCH = "proto/handoff"
NOTE = ".agent/proto%2Fhandoff.md"
PROMPTS = [
    "Prototype on this same branch using the installed harness. Implement label(text) "
    "in label.py to trim and collapse whitespace while preserving case. The reason "
    "for preserving case is that launch partner Northstar requires its original branding. "
    "There will be a second round in a fresh session: blank input should then return "
    "'Untitled', but defer that behavior for now. This round only implements whitespace "
    "normalization. Use proto. For this disposable test, skip commits, pushes, PRs, "
    "delegation, and external services; only modify this repository. Validate locally "
    "with Python assertions, then stop for feedback.",
    "Continue the prototype on this same branch. Implement the deferred blank-input "
    "behavior from the saved requirements. Write rationale.md explaining the earlier "
    "casing decision. Use proto. For this disposable test, skip commits, pushes, PRs, "
    "delegation, and external services; only modify this repository. Validate locally "
    "with Python assertions, then stop for feedback.",
]


def analyze(path):
    """Count completed items once; missing usage or completion stays unknown."""
    usage = collections.Counter()
    items = {}
    errors = []
    threads = []
    completed = 0
    turn = 0
    pending = False
    missing_usage = False
    with open(path) as stream:
        for line in stream:
            if not line.strip():
                continue
            event = json.loads(line)
            kind = event.get("type")
            if kind == "thread.started":
                threads.append(event["thread_id"])
            elif kind == "turn.started":
                turn += 1
                pending = True
            elif kind == "turn.completed":
                completed += 1
                pending = False
                missing_usage |= not bool(event.get("usage"))
                usage.update(event.get("usage") or {})
            elif kind in ("error", "turn.failed"):
                errors.append(event)
            elif kind == "item.completed":
                item = event["item"]
                items[(len(threads), turn, item["id"])] = item
    calls = collections.Counter()
    failures = 0
    result_bytes = 0
    for item in items.values():
        kind = item.get("type")
        if kind in ("command_execution", "mcp_tool_call", "web_search", "file_change"):
            calls[kind] += 1
        if item.get("status") == "failed" or item.get("exit_code") not in (None, 0):
            failures += 1
        result_bytes += len(item.get("aggregated_output", "").encode())
    return {
        "transcript": str(path), "threads": threads,
        "completed_turns": completed,
        "status": "failed" if errors else "completed" if completed and not pending else "incomplete",
        "tokens": dict(usage) if usage and not missing_usage and not pending else None,
        "tool_calls": dict(calls), "tool_calls_total": sum(calls.values()),
        "failed_items": failures, "command_output_bytes": result_bytes,
        "errors": errors,
    }


def git(repo, *args):
    return subprocess.check_output(["git", "-C", str(repo), *args], text=True).strip()


def behavior(repo, blank):
    check = (
        "from label import label; "
        "assert label('  Northstar   Labs  ') == 'Northstar Labs'; "
        "assert label('a\\tb\\nc') == 'a b c'; "
        f"assert label('   ') == {blank!r}"
    )
    result = subprocess.run(["python3", "-c", check], cwd=repo, capture_output=True, text=True)
    return {"passed": result.returncode == 0, "stderr": result.stderr}


def run(model):
    # Each run owns fresh files. Never reset or reuse a previous fixture.
    destination = ROOT / "bench" / "runs"
    destination.mkdir(exist_ok=True)
    run_dir = Path(tempfile.mkdtemp(prefix="handoff-", dir=destination))
    repo = run_dir / "repo"
    repo.mkdir()
    harness = (ROOT / "agents/AGENTS.md").read_text()
    (repo / "AGENTS.md").write_text(harness + "\n## Probe repository\n\nLocal oracle: python3 assertions against label.py. No compile, lint, build, or remote CI. Skills are in .agents/skills/. This disposable fixture skips commits by explicit user instruction.\n")
    for name in ("proto", "ponytail"):
        shutil.copytree(ROOT / "agents/skills" / name, repo / ".agents/skills" / name)
    (repo / "label.py").write_text("def label(text):\n    return text\n")
    git(repo, "init", "-b", BRANCH)
    git(repo, "add", "AGENTS.md", ".agents", "label.py")
    git(repo, "-c", "user.name=Harness probe", "-c", "user.email=probe@example.invalid",
        "-c", "core.hooksPath=/dev/null", "commit", "--no-gpg-sign", "-m", "chore: seed fixture")
    manifest = {
        "scenario": "handoff-v1", "model_requested": model, "reasoning_effort": "low",
        "harness_commit": git(ROOT, "rev-parse", "HEAD"),
        "runner_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "harness_sha256": hashlib.sha256(harness.encode()).hexdigest(),
        "skill_sha256": {name: hashlib.sha256((repo / ".agents/skills" / name / "SKILL.md").read_bytes()).hexdigest() for name in ("proto", "ponytail")},
        "cli": subprocess.check_output(["codex", "--version"], text=True).strip(),
        "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "rounds": [],
    }
    print(run_dir, flush=True)
    note_before = ""
    for index, prompt in enumerate(PROMPTS, 1):
        (run_dir / f"round-{index}.prompt.txt").write_text(prompt)
        transcript = run_dir / f"round-{index}.jsonl"
        command = ["codex", "exec", "--ignore-user-config", "--json", "--ephemeral",
                   "-m", model, "-c", 'model_reasoning_effort="low"',
                   "-s", "workspace-write", "-C", str(repo), prompt]
        started = time.monotonic()
        with transcript.open("w") as output, (run_dir / f"round-{index}.stderr").open("w") as err:
            try:
                result = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=output, stderr=err, timeout=300)
                exit_code = result.returncode
            except subprocess.TimeoutExpired:
                exit_code = 124
        note = (repo / NOTE).read_text() if (repo / NOTE).exists() else ""
        (run_dir / f"round-{index}.note.md").write_text(note)
        try:
            metrics = analyze(transcript)
        except (ValueError, KeyError, TypeError) as error:
            metrics = {"status": "invalid", "tokens": None, "error": str(error)}
        ignored = subprocess.run(["git", "check-ignore", "-q", NOTE], cwd=repo).returncode == 0
        checks = {
            "behavior": behavior(repo, "" if index == 1 else "Untitled"),
            "note_exists": bool(note), "note_refreshed": bool(note) and note != note_before,
            "note_ignored": ignored, "note_untracked": not git(repo, "ls-files", NOTE),
            "same_branch": git(repo, "branch", "--show-current") == BRANCH,
        }
        if index == 2:
            rationale = (repo / "rationale.md").read_text() if (repo / "rationale.md").exists() else ""
            checks["rationale_preserved"] = "northstar" in rationale.lower() and "brand" in rationale.lower()
        passed = exit_code == 0 and metrics["status"] == "completed" and all(
            value["passed"] if isinstance(value, dict) else value for value in checks.values())
        manifest["rounds"].append({"round": index, "exit_code": exit_code,
                                   "wall_seconds": round(time.monotonic() - started, 2),
                                   "metrics": metrics, "checks": checks, "passed": passed})
        (run_dir / "result.json").write_text(json.dumps(manifest, indent=2) + "\n")
        print(f"round {index}: {'pass' if passed else 'fail'}", flush=True)
        note_before = note
        if exit_code != 0:
            break
    return 0 if len(manifest["rounds"]) == 2 and all(r["passed"] for r in manifest["rounds"]) else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    runner = commands.add_parser("run")
    runner.add_argument("--model", default=MODEL)
    reader = commands.add_parser("analyze")
    reader.add_argument("transcripts", nargs="+")
    args = parser.parse_args()
    if args.command == "run":
        return run(args.model)
    for path in args.transcripts:
        print(json.dumps(analyze(path)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
