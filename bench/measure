#!/usr/bin/env python3
"""Run a disposable harness probe or measure explicit Codex exec or pi JSONL transcripts.

Usage: bench/measure verify --local
       bench/measure verify --behavior [--run] [--regression --agent pi --model gpt-6-luna --effort medium]
       bench/measure run [--model gpt-6-luna] [--scenario handoff-v1]
       bench/measure analyze SESSION.jsonl [SESSION.jsonl ...]
"""

import argparse
import collections
import hashlib
import json
import os
from pathlib import Path
import signal
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
from scenarios import ARCHIVED_NOTE, CASES, EXTRA_CASES, CASE_SECTIONS, CASE_SKILLS, EXPECTED, NOTE, PROMPTS, PUBLICATION, SANDBOX, check, git, seed, snapshot


def read_note(repo):
    """land archives a merged note, so the retained evidence follows it there."""
    for name in (NOTE, ARCHIVED_NOTE):
        if (repo / name).exists():
            return (repo / name).read_text()
    return ""

ROOT = Path(__file__).resolve().parent.parent
MODEL = "gpt-6-luna"
MODELS = (MODEL, "gpt-6.1-sol")
BATCH = ROOT / "bench/runs/effectiveness-v1"
LIMIT = 32
# pi reaches OpenAI models through its Codex subscription provider.
PI_PROVIDER = "openai-codex"


def analyze(path):
    """Count completed items once; missing usage or completion stays unknown."""
    usage = collections.Counter()
    items = {}
    errors = []
    threads = []
    completed = 0
    turn = 0
    pending = False
    missing_usage = False
    with open(path) as stream:
        for line in stream:
            if not line.strip():
                continue
            event = json.loads(line)
            kind = event.get("type")
            if kind == "thread.started":
                threads.append(event["thread_id"])
            elif kind == "turn.started":
                turn += 1
                pending = True
            elif kind == "turn.completed":
                completed += 1
                pending = False
                missing_usage |= not bool(event.get("usage"))
                usage.update(event.get("usage") or {})
            elif kind in ("error", "turn.failed"):
                errors.append(event)
            elif kind == "item.completed":
                item = event["item"]
                items[(len(threads), turn, item["id"])] = item
    calls = collections.Counter()
    failures = 0
    result_bytes = 0
    for item in items.values():
        kind = item.get("type")
        if kind in ("command_execution", "mcp_tool_call", "web_search", "file_change"):
            calls[kind] += 1
        if item.get("status") == "failed" or item.get("exit_code") not in (None, 0):
            failures += 1
        result_bytes += len(item.get("aggregated_output", "").encode())
    return {
        "transcript": str(path), "threads": threads,
        "completed_turns": completed,
        "status": "failed" if errors else "completed" if completed and not pending else "incomplete",
        "tokens": dict(usage) if usage and not missing_usage and not pending else None,
        "tool_calls": dict(calls), "tool_calls_total": sum(calls.values()),
        "failed_items": failures, "command_output_bytes": result_bytes,
        "errors": errors,
    }


def analyze_pi(path):
    """pi --mode json: usage lives on each final assistant message, tools on tool_execution_end."""
    usage = collections.Counter()
    calls = collections.Counter()
    errors = []
    failures = result_bytes = turns = 0
    started = settled = False
    final_stop = None
    with open(path) as stream:
        for line in stream:
            if not line.strip():
                continue
            event = json.loads(line)
            kind = event.get("type")
            if kind == "agent_start":
                started = True
            elif kind == "agent_settled":
                settled = True
            elif kind == "turn_end":
                turns += 1
            elif kind == "message_end" and event["message"].get("role") == "assistant":
                message = event["message"]
                usage.update({k: v for k, v in (message.get("usage") or {}).items() if isinstance(v, int)})
                final_stop = message.get("stopReason")
                if final_stop in ("error", "aborted"):
                    errors.append({"stopReason": message.get("stopReason"), "error": message.get("errorMessage")})
            elif kind == "tool_execution_end":
                calls[event.get("toolName", "unknown")] += 1
                failures += bool(event.get("isError"))
                result_bytes += sum(len(part.get("text", "").encode()) for part in (event.get("result") or {}).get("content", []))
    return {
        "transcript": str(path), "threads": [],
        "completed_turns": turns,
        # pi retries transient provider errors itself, so an earlier error that recovered is not a failure.
        "status": "failed" if final_stop in ("error", "aborted") else "completed" if started and settled else "incomplete",
        "tokens": dict(usage) if usage and settled else None,
        "tool_calls": dict(calls), "tool_calls_total": sum(calls.values()),
        "failed_items": failures, "command_output_bytes": result_bytes,
        "errors": errors,
    }


def last_message_pi(path):
    text = ""
    with open(path) as stream:
        for line in stream:
            if line.strip():
                event = json.loads(line)
                if event.get("type") == "message_end" and event["message"].get("role") == "assistant":
                    content = event["message"].get("content") or []
                    text = "".join(part.get("text", "") for part in content if part.get("type") == "text") or text
    return text


def last_message(path):
    text = ""
    with open(path) as stream:
        for line in stream:
            if line.strip():
                event = json.loads(line)
                if event.get("type") == "item.completed" and event["item"].get("type") == "agent_message":
                    text = event["item"].get("text", "")
    return text


def save(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()


def sections(text):
    """Split an instruction file at its level-two headings, so a case hashes only what it reads."""
    current, body = "(preamble)", {}
    for line in text.splitlines(keepends=True):
        if line.startswith("## "):
            current = line[3:].strip()
        body.setdefault(current, []).append(line)
    return {name: "".join(lines) for name, lines in body.items()}


def surfaces(case):
    """The instruction surfaces this case declares, plus the runner and the fixtures."""
    files = [Path(__file__).resolve(), ROOT / "bench/scenarios.py", ROOT / "bench/fixture_gh.py"]
    for name in CASE_SKILLS[case]:
        files.extend(p for p in (ROOT / "agents/skills" / name).rglob("*") if p.is_file())
    sources = {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(set(files)) if p.exists()}
    parts = sections((ROOT / "agents/AGENTS.md").read_text())
    # A case that declares no section is seeded without agents/AGENTS.md and hashes none of it.
    # Every other case also hashes the preamble, which precedes every heading and cannot be declared.
    for name in (("(preamble)",) + tuple(CASE_SECTIONS[case])) if CASE_SECTIONS[case] else ():
        if name not in parts:
            # A renamed or deleted section must fail loudly, not silently drop from provenance.
            raise SystemExit(f"{case} declares agents/AGENTS.md section {name!r}, which no longer exists")
        sources[f"agents/AGENTS.md#{name}"] = hashlib.sha256(parts[name].encode()).hexdigest()
    return sources


def inputs(case, model, agent="codex", effort="low"):
    """Hash actual sources, not just a commit that may hide local modifications."""
    sources = surfaces(case)
    # pi runs with an empty agent directory, so no user-level instructions reach it.
    codex_directory = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    ambient = {} if agent == "pi" else {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in
               (codex_directory / "AGENTS.md", codex_directory / "AGENTS.override.md") if p.is_file()}
    # pi has no sandbox and needs the network for the model, so its manifest says so.
    extra = {} if agent == "codex" else {"agent": agent, "provider": PI_PROVIDER}
    if agent == "pi":
        settings_path = ROOT / "pi/settings.json"
        sources["pi/settings.json"] = hashlib.sha256(settings_path.read_bytes()).hexdigest()
        managed = json.loads(settings_path.read_text())
        extra["settings"] = {key: managed[key] for key in ("defaultTools", "codemode")}
        extra["mcp"] = {"mcpServers": {}}
    sandbox = {"sandbox": SANDBOX.get(case, "workspace-write"), "network_access": False, "ignore_user_config": True} \
        if agent == "codex" else {"sandbox": "none", "network_access": True, "ignore_user_config": True}
    return {"scenario": case, "prompts": PROMPTS[case], "expected": EXPECTED[case], **extra,
            "model_requested": model, "reasoning_effort": effort, "timeout_seconds": 300, **sandbox,
            "python": sys.version, "platform": sys.platform, "sources": sources, "ambient_instructions": ambient}


def cli_version(agent="codex", cache={}):
    """Resolve once; verify --behavior must not need the agent CLI installed."""
    if agent not in cache:
        try:
            cache[agent] = subprocess.check_output(["pi-agent" if agent == "pi" else agent, "--version"], text=True).strip()
        except (OSError, subprocess.CalledProcessError):
            cache[agent] = None
    return cache[agent]


def sessions_used(batch):
    """Rounds that reached a model. An access error never ran, so it costs nothing."""
    return sum(1 for p in batch.glob("*/result.json")
               for row in json.loads(p.read_text())["rounds"] if row.get("status") != "unavailable")


# Cases a session cannot run safely yet: they are defined but never started. workspace-requested
# asks for a worktree, and a session can still reach the real herdr (a login shell's PATH puts it
# ahead of the stub) and has created a real worktree of the host repository once.
UNSAFE = ("workspace-requested",)


def matrix():
    # Freeze order: the unchanged Luna handoff is always the first model trial.
    result = [(case, model, 1) for model in MODELS for case in CASES[:7]]
    result += [("handoff-v1", MODEL, trial) for trial in (2, 3)]
    result += [(case, model, 1) for model in MODELS for case in CASES[7:] if case not in UNSAFE]
    return result


def regression(models=MODELS):
    """The rows a publication-authority change can break, within one batch's session cap.

    Editing the runner or bench/scenarios.py stales every case, because both are hashed
    everywhere; per-case provenance narrows only instruction edits. What this leaves out
    is handoff-v1 on the second model and its two extra Luna trials, which the design
    fixes as one first trial rather than re-running.
    """
    cases = PUBLICATION + ("route-open-shape", "route-bounded", "external-communication",
                           "feedback", "land-open", "land-merged", "recoverable", "unrecoverable",
                           "workspace-default")
    # UNSAFE cases stay out (see UNSAFE). workspace-default stays in: it never asks for a
    # worktree, and no recorded run of it called herdr.
    return [("handoff-v1", models[0], 1)] + [(case, model, 1) for model in models for case in cases]


def evidence_hash(run_dir):
    return digest({p.name: hashlib.sha256(p.read_bytes()).hexdigest()
                   for p in sorted(run_dir.glob("round-*")) if p.is_file()})


def session_env(repo, run_dir, base=None):
    """The environment a session runs in: outside herdr, with no way to reach the operator's server.

    An inherited HERDR_* (env flag, pane id, socket, binary) would let a session drive the real
    herdr, and herdr also finds the live server through its default socket, so the socket path is
    pointed somewhere that cannot exist and a failing herdr stub leads PATH. The stub is seeded with
    the fixture (before any snapshot), in .fixture/herdr-bin, so this writes nothing.
    """
    env = {k: v for k, v in (os.environ if base is None else base).items() if not k.startswith("HERDR_")}
    env["HERDR_SOCKET_PATH"] = str(Path(run_dir) / "no-herdr.sock")
    env["PATH"] = str(Path(repo) / ".fixture/herdr-bin") + os.pathsep + env.get("PATH", "")
    return env


def run_case(batch, case, model, trial, provenance):
    if case in UNSAFE:
        raise SystemExit(f"{case} is not safe to run yet; see UNSAFE in bench/measure")
    batch.mkdir(parents=True, exist_ok=True)
    if sessions_used(batch) + len(PROMPTS[case]) > LIMIT:
        return None
    run_dir = Path(tempfile.mkdtemp(prefix=f"{case}-{model}-{trial}-", dir=batch))
    agent = provenance.get("agent", "codex")
    manifest = {"inputs": provenance, "input_hash": digest(provenance), "trial": trial, "cli": cli_version(agent),
                "harness_commit": git(ROOT, "rev-parse", "HEAD"), "rounds": [],
                "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    save(run_dir / "result.json", manifest)
    # Retain exact instruction contents even after this source checkout changes.
    for name in sorted({name.split("#")[0] for name in provenance["sources"]}):
        target = run_dir / "sources" / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes((ROOT / name).read_bytes())
    for index, name in enumerate(provenance["ambient_instructions"]):
        (run_dir / "sources" / f"ambient-{index}.md").write_bytes(Path(name).read_bytes())
    # Outside the checkout, so parent project AGENTS.md cannot contaminate fixtures.
    fixture_dir = Path(tempfile.mkdtemp(prefix="harness-fixture-"))
    repo = fixture_dir / "repo"
    manifest["fixture_path"] = str(repo)
    save(run_dir / "result.json", manifest)
    seed(repo, case, ROOT)
    print(run_dir, flush=True)
    for index, prompt in enumerate(PROMPTS[case], 1):
        before = snapshot(repo)
        note_before = read_note(repo)
        save(run_dir / f"round-{index}.before.json", before)
        (run_dir / f"round-{index}.prompt.txt").write_text(prompt)
        transcript = run_dir / f"round-{index}.jsonl"
        env = session_env(repo, run_dir)
        if agent == "pi":
            # pi has no sandbox: the fixture's gh substitute, invalid forge credentials, and
            # local bare remotes are the only boundary. An empty agent directory holding just
            # the credential link keeps ~/.pi/agent instructions and settings out, and
            # --no-skills plus the fixture's own skill directory keeps ~/.agents/skills out.
            agent_dir = Path(tempfile.mkdtemp(prefix="pi-agent-"))
            save(agent_dir / "settings.json", provenance["settings"])
            save(agent_dir / "mcp.json", provenance["mcp"])
            credential = Path.home() / ".pi/agent/auth.json"
            # pi writes auth.json in place, so a token refresh lands in the real file through
            # the link; its lock lives beside the link, so do not run an interactive pi meanwhile.
            if credential.exists():
                (agent_dir / "auth.json").symlink_to(credential)
            env["PI_CODING_AGENT_DIR"] = str(agent_dir)
            command = ["pi-agent", "--mode", "json", "-p", "--no-session", "--offline", "--no-approve",
                       "--no-extensions", "--no-prompt-templates", "--no-themes", "--no-skills",
                       "--extension", "builtin:codemode", "--extension", "builtin:mcp",
                       "--provider", PI_PROVIDER, "--model", model, "--thinking", provenance["reasoning_effort"]]
            if (repo / ".agents/skills").is_dir():
                command += ["--skill", str(repo / ".agents/skills")]
            command.append(prompt)
        else:
            command = ["codex", "exec", "--ignore-user-config", "--json", "--ephemeral",
                       "-m", model, "-c", f'model_reasoning_effort="{provenance.get("reasoning_effort", "low")}"',
                       "-c", "sandbox_workspace_write.network_access=false",
                       "-s", SANDBOX.get(case, "workspace-write"), "-C", str(repo), prompt]
        env["PATH"] = str(repo / ".fixture/bin") + os.pathsep + env.get("PATH", "")
        env.update(GH_HOST="example.invalid", GH_TOKEN="fixture-no-real-token", GITHUB_TOKEN="fixture-no-real-token")
        started = time.monotonic()
        row = {"round": index, "status": "started", "command": command, "passed": False}
        manifest["rounds"].append(row)
        save(run_dir / "result.json", manifest)  # An interrupted call consumes its budget.
        with transcript.open("w") as output, (run_dir / f"round-{index}.stderr").open("w") as err:
            process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=output, stderr=err,
                                       env=env, cwd=repo, start_new_session=True)
            try:
                exit_code = process.wait(timeout=300)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
                exit_code = 124
        if agent == "pi":
            shutil.rmtree(agent_dir, ignore_errors=True)
        (run_dir / f"round-{index}.note.md").write_text(read_note(repo))
        try:
            metrics = analyze_pi(transcript) if agent == "pi" else analyze(transcript)
            message = last_message_pi(transcript) if agent == "pi" else last_message(transcript)
        except (ValueError, KeyError, TypeError) as error:
            metrics, message = {"status": "invalid", "tokens": None, "error": str(error)}, ""
        try:
            checks = check(repo, case, index, before, note_before, message,
                           [run_dir / f"round-{n}.jsonl" for n in range(1, index + 1)])
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            checks = {"oracle_error": {"passed": False, "error": str(error)}}
        passed = exit_code == 0 and metrics["status"] == "completed" and all(
            value["passed"] if isinstance(value, dict) else value for value in checks.values())
        stderr = (run_dir / f"round-{index}.stderr").read_text()
        # Access errors are distinguishable from completed turns with wrong artifacts.
        # pi --mode json exits 0 even when the model call fails, so its failure is the transcript's status.
        call_failed = exit_code != 0 or (agent == "pi" and metrics["status"] in ("failed", "invalid"))
        access = call_failed and any(word in (stderr + json.dumps(metrics)).lower() for word in ("not supported", "model_not_found", "unauthorized", "authentication", "not available", "not have access"))
        row.update(exit_code=exit_code, status="unavailable" if access else "finished",
                   wall_seconds=round(time.monotonic() - started, 2), metrics=metrics, checks=checks, passed=passed)
        save(run_dir / f"round-{index}.after.json", snapshot(repo))
        save(run_dir / f"round-{index}.checks.json", checks)
        save(run_dir / "result.json", manifest)
        print(f"{case} {model} trial {trial} round {index}: {'pass' if passed else row['status'] if access else 'fail'}", flush=True)
        if call_failed:
            break
    manifest["evidence_hash"] = evidence_hash(run_dir)
    shutil.copytree(fixture_dir, run_dir / "fixture")
    shutil.rmtree(fixture_dir, ignore_errors=True)
    save(run_dir / "result.json", manifest)
    return run_dir


def acceptance(run_dir, provenance, trial):
    manifest = json.loads((run_dir / "result.json").read_text())
    if manifest.get("input_hash") != digest(provenance) or manifest.get("trial") != trial:
        return "stale"
    if any(row.get("status") == "unavailable" for row in manifest["rounds"]):
        return "unavailable"
    if len(manifest["rounds"]) != len(provenance["prompts"]) or not all(row.get("passed") for row in manifest["rounds"]):
        return "failed"
    if manifest.get("evidence_hash") != evidence_hash(run_dir):
        return "changed-evidence"
    review_path = run_dir / "review.json"
    if not review_path.exists():
        return "awaiting-transcript-review"
    review = json.loads(review_path.read_text())
    if review.get("input_hash") != manifest["input_hash"] or review.get("evidence_hash") != manifest["evidence_hash"]:
        return "stale-review"
    if not review.get("observations") or not review.get("reviewer"):
        return "incomplete-review"
    return "passed" if review.get("passed") is True else "review-failed"


def verify_behavior(batch, execute=False, selected=None, agent="codex", effort="low", subset=None, record=None):
    batch = Path(batch).resolve()
    report = []
    for case, model, trial in selected or matrix():
        provenance = inputs(case, model, agent, effort)
        matches = [p.parent for p in sorted(batch.glob("*/result.json"))
                   if (lambda row: row.get("input_hash") == digest(provenance) and row.get("trial") == trial)(json.loads(p.read_text()))]
        # Retry only when every prior attempt never reached the model.
        if execute and all(acceptance(p, provenance, trial) == "unavailable" for p in matches):
            result = run_case(batch, case, model, trial, provenance)
            if result:
                matches = [result]
        statuses = [acceptance(path, provenance, trial) for path in matches]
        # Never discard a failed matching attempt in favor of a survivor.
        exhausted = sessions_used(batch) + len(PROMPTS[case]) > LIMIT if batch.exists() else False
        status = "passed" if statuses and all(s == "passed" for s in statuses) else next((s for s in statuses if s != "passed"), "budget-exhausted" if exhausted else "missing")
        report.append({"case": case, "model": model, "trial": trial, "status": status,
                       "runs": [str(p) for p in matches], "input_hash": digest(provenance),
                       "surfaces": sorted(provenance["sources"])})
    used = sessions_used(batch)
    result = {"kind": "behavioral-smoke", "sessions_used": used, "session_cap": LIMIT,
              "passed": used <= LIMIT and all(row["status"] == "passed" for row in report), "results": report}
    print(json.dumps(result, indent=2), flush=True)
    # A single case must not overwrite the matrix record; a named subset keeps its own.
    if batch.exists() and (selected is None or subset == "regression"):
        # A non-default agent or model set names its own record, so it never passes for the default one.
        save(batch / f"acceptance{'-regression' if subset else ''}{'-' + record if record else ''}.json", result)
    return 0 if result["passed"] else 1


def verify_local():
    commands = [[sys.executable, "-m", "py_compile", "bench/measure", "bench/scenarios.py", "bench/fixture_gh.py", "bench/test_measure.py"],
                [sys.executable, "bench/test_measure.py"], ["git", "diff", "--check", "HEAD"]]
    for command in commands:
        if subprocess.run(command, cwd=ROOT).returncode:
            return 1
    # git diff --check never sees untracked files.
    untracked = subprocess.check_output(["git", "ls-files", "--others", "--exclude-standard", "bench", "AGENTS.md", "agents"], cwd=ROOT, text=True).split()
    dirty = [f"{path}:{n}" for path in untracked for n, line in enumerate((ROOT / path).read_text(errors="replace").splitlines(), 1) if line != line.rstrip()]
    if dirty:
        print("trailing whitespace: " + ", ".join(dirty))
        return 1
    print("Local tooling checks passed; harness behavioral acceptance is separate.")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    runner = commands.add_parser("run")
    runner.add_argument("--model", default=MODEL)
    runner.add_argument("--scenario", choices=[case for case in CASES + EXTRA_CASES if case not in UNSAFE], default="handoff-v1")
    runner.add_argument("--batch", type=Path, default=BATCH)
    runner.add_argument("--trial", type=int, default=1)
    runner.add_argument("--agent", choices=("codex", "pi"), default="codex")
    runner.add_argument("--effort", default="low")
    verifier = commands.add_parser("verify")
    mode = verifier.add_mutually_exclusive_group(required=True)
    mode.add_argument("--local", action="store_true")
    mode.add_argument("--behavior", action="store_true")
    verifier.add_argument("--run", action="store_true", help="Explicitly authorize missing model sessions, capped at 32 per retained batch")
    verifier.add_argument("--regression", action="store_true", help="Only the rows a publication-authority change can break")
    verifier.add_argument("--batch", type=Path, default=BATCH)
    verifier.add_argument("--agent", choices=("codex", "pi"), default="codex")
    verifier.add_argument("--effort", default="low")
    verifier.add_argument("--model", action="append", help="Restrict the regression subset to these models (repeatable)")
    reader = commands.add_parser("analyze")
    reader.add_argument("transcripts", nargs="+")
    reader.add_argument("--agent", choices=("codex", "pi"), default="codex")
    args = parser.parse_args()
    if args.command == "run":
        return verify_behavior(args.batch, execute=True, selected=[(args.scenario, args.model, args.trial)],
                               agent=args.agent, effort=args.effort)
    if args.command == "verify":
        if args.local and args.run:
            parser.error("--run requires --behavior")
        if args.model and not args.regression:
            parser.error("--model requires --regression")
        if args.local:
            return verify_local()
        if args.agent != "codex" and not args.regression:
            parser.error("the full matrix is Codex-only; pass --regression for another agent")
        models = tuple(args.model or MODELS)
        selected = regression(models) if args.regression else None
        record = None if (args.agent, models, args.effort) == ("codex", MODELS, "low") else "-".join((args.agent, *models, args.effort))
        return verify_behavior(args.batch, args.run, selected, args.agent, args.effort,
                               "regression" if args.regression else None, record)
    for path in args.transcripts:
        print(json.dumps(analyze_pi(path) if args.agent == "pi" else analyze(path)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
