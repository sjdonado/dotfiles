{
  "mcpServers": {
    "agent-browser": {
      "command": "agent-browser",
      "args": ["mcp"],
      "exposure": "codemode"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect", "--userDataDir", "~/.agent-browser/profile", "--no-usage-statistics", "--no-performance-crux"],
      "exposure": "codemode"
    },
    "ios-simulator": {
      "command": "npx",
      "args": ["-y", "ios-simulator-mcp"],
      "exposure": "codemode"
    },
    "git-bug": {
      "command": "bun",
      "args": ["run", "~/.config/dotfiles/git-bug-mcp/index.ts"],
      "exposure": "codemode"
    }
  }
}
